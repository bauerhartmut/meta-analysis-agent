[TEMPLATE]
# === LLM Backend ===
# tudagpt (HRZ TU Darmstadt) | ollama (lokal) | kaggle_api | pc | auto
# Standard ist die HRZ-API: kein lokales Modell für die Recherchearbeit. Die
# anderen Backends müssen ausdrücklich gewählt werden, es gibt keinen stillen
# Rückfall auf ein lokales Modell.
LLM_BACKEND=tudagpt

# === Semantische Suche ===
# Standard: kein lokales Modell. Die Suche filtert Kandidaten per Stichwort und
# lässt danach ein kleines Chat-Modell über die HRZ-API ranken (ein billiger
# Aufruf pro Query, ~2 s über 300 Quellen).
EMBEDDINGS_ENABLED=0
RETRIEVAL_MODEL=gwdg/meta-llama-3.1-8b-instruct
RETRIEVAL_CANDIDATES=25
# Optional: Vektorsuche mit einem lokalen Embedding-Modell. Nur nötig, wenn
# EMBEDDINGS_ENABLED=1 - dann müssen OLLAMA_HOST und das Modell erreichbar sein.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODEL=qwen3:14b

# === TUDaGPT (Hochschulrechenzentrum TU Darmstadt) ===
# OpenAI-compatible chat API; used when LLM_BACKEND=tudagpt. The key must be
# requested from the HRZ and the endpoint is only reachable from the campus
# network/VPN. Chat only - there is no embeddings route.
# TUDAGPT_API_BASE=https://tudagpt2.hrz.tu-darmstadt.de/api
# TUDAGPT_MODEL=gwdg/qwen3.5-397b-a17b
# TUDAGPT_API_KEY=

# === Search Configuration ===
# duckduckgo-search 3.7.0 requires `primp` installed and an httpx < 0.28 (or a
# compatible upgrade). Without those, DuckDuckGo fails fast and the circuit
# breaker skips it (no 35s stalls). To re-enable DDG:
#   pip install duckduckgo-search primp "httpx<0.28"
SEARCH_PROVIDER=duckduckgo

# Optional: Semantic Scholar personal API key (free - request at
# https://www.semanticscholar.org/product/api) - moves out of the shared anonymous
# pool and removes most 429 rate limits.
# SEMANTIC_SCHOLAR_API_KEY=
# Optional: your e-mail for OpenAlex/Crossref 'polite pool' rate limiting.
# OPENALEX_MAILTO=you@example.com

# === Database ===
# Basisdatei. Ohne Topic (nur Dashboard) wird sie benutzt.
DATABASE_URL=data/research.db
# Eine Datenbank pro Thema: ein Lauf mit --topic schreibt in
# data/research-<slug>-<hash>.db, damit Korpus, Programm und Knowledge Graph
# nicht das vorige Thema mitschleppen. 0 = alle Themen teilen DATABASE_URL
# (Ergebnis: ein gemischter Graph, siehe README).
DATABASE_PER_TOPIC=1
# Die Token-Abrechnung bleibt bewusst themenübergreifend: llm_usage liegt in
# data/research-usage.db, sonst hätte "Tokens heute" eine Antwort pro Thema.

# === Research Settings ===
MAX_RESEARCH_CYCLES=0
MAX_SOURCES_PER_CYCLE=10
RESEARCH_INTERVAL=30
MAX_WEB_PAGES_PER_SEARCH=5
MAX_CONTENT_LENGTH=15000

# === Dashboard ===
# Default 127.0.0.1 (empfohlen). 0.0.0.0 macht das Dashboard im lokalen
# Netz bedienbar (Start/Stop ohne Auth) - noetigt nur bewusst setzen.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=data/research_agent.log

# === Research Engine (föderierte Suche) ===
# 1 = Query-Planer + Provider-Syntax + DOI/Titel-Dedupe + Ranking + Query-
# Telemetrie (research/engine.py). 0 = altes Verhalten (ein Keyword-String,
# Provider-Reihenfolge, URL-Dedupe) zum Vergleich.
RESEARCH_ENGINE_ENABLED=1
# Geplante Queries pro Zyklus (zusätzlich läuft eine breite Sweep-Query).
QUERIES_PER_CYCLE=3
# Treffer pro Query und Provider. Der Zyklus analysiert weiterhin höchstens
# MAX_SOURCES_PER_CYCLE; der größere Pool dient dem Ranking.
SEARCH_RESULTS_PER_QUERY=10

# === Search Strategy ===
# After this many cycles in a row without a single new source, the agent stops
# repeating its usual queries and escalates: method-anchored queries
# (meta-analysis, cohort, replication), then hypothesis-derived entity queries.
# A productive cycle switches back to the normal queries. 0 disables the switch.
SEARCH_STALL_CYCLES=3

# === Critique Pipeline ===
CONTRADICTION_PAIRS_PER_CYCLE=8
SOURCE_EVAL_PER_CYCLE=5
# Analyzer relevance score (0-1, scored against the research TOPIC) a source
# needs before it is analyzed again and before facts are extracted from it.
# 0 disables the gate.
SOURCE_RELEVANCE_THRESHOLD=0.25

# === Work Queue (stundenlange Läufe) ===
# Der Zyklus arbeitet zusätzlich N Punkte aus dem Rückstand ab: fehlender
# Volltext bei Snippet-Quellen, ungeprüfte Hypothesen, offene Fragen,
# Zitationsnachbarn relevanter Arbeiten. Das hält einen Lauf produktiv, wenn die
# Suche nur noch Bekanntes findet. 0 schaltet den Rückstand ab.
WORK_ITEMS_PER_CYCLE=2
# Hypothesen-Bremse: Solange so viele aktive Hypothesen noch gar keine Evidenz
# haben, erzeugt ein Zyklus keine neuen, sondern arbeitet den Rückstand ab. Die
# Erzeugung ist billig, die Prüfung nicht - ohne Bremse wächst die Warteschlange
# schneller, als sie abgearbeitet wird. 0 schaltet die Bremse ab.
HYPOTHESIS_BACKLOG_LIMIT=25
# Laufzeitbudget in Minuten. Danach endet der Lauf mit einem Bericht unter
# data/reports/. 0 = kein Limit (läuft bis zum Stopp oder bis der Rückstand
# erschöpft ist).
RUN_BUDGET_MINUTES=0
# Endet den Lauf, wenn so viele Zyklen in Folge weder eine brauchbare neue
# Quelle noch einen erledigten Rückstandspunkt produziert haben und die
# Warteschlange leer ist. 0 schaltet die Sättigungserkennung ab.
SATURATION_CYCLES=6

# === Simulierte Experimente (Labor) ===
# Der Agent schreibt ein Python-Skript, prüft es gegen eine Import-Allowlist,
# führt es in einem eigenen Verzeichnis ohne Netz und ohne Secrets aus und
# bewertet das Ergebnis gegen die vorher festgeschriebene Vorhersage.
SIMULATIONS_ENABLED=1
SIM_TIMEOUT_SECONDS=180
# Deckel für die Evidenzstärke einer Simulation: sie prüft die Logik einer
# Vorhersage, nicht die Welt, und darf nie so viel zählen wie eine Studie.
SIM_EVIDENCE_CAP=0.6
SIM_DIR=data/simulations
# Jedes Experiment wiederholt die Studie mit frischem Rauschen. Ein einzelner
# signifikanter Lauf ist genau das, was man bei 20 Läufen ohne Effekt erwartet -
# das Verdikt hängt daran, wie viele Wiederholungen tragen (Minimum 3).
SIM_REPLICATIONS=5
# Nach einem unklaren Ergebnis wird die Studie wiederholt (Replikation), aber
# nicht endlos: so viele Experimente pro Hypothese sind das Maximum.
SIM_MAX_PER_HYPOTHESIS=2
# Vor der echten Studie wird jedes Skript von einem Reviewer geprüft und mit
# kleinem n (SIM_SMOKE_N) einmal testweise ausgeführt. Scheitert Prüfung,
# Testlauf oder Lauf, geht die konkrete Fehlermeldung zurück an den Schreiber -
# so viele Skript-Versuche hat ein Experiment.
SIM_SCRIPT_ATTEMPTS=3
SIM_SMOKE_N=30
SIM_SMOKE_TIMEOUT=45
# Known-Answer-Tests: das Skript rechnet zuerst Parameter, deren Antwort die
# Theorie festlegt (Nullrate = alpha, Effektskalierung, fester Seed, analytische
# t-Test-Power). Widerspricht es der Theorie, entsteht keine Evidenz.
SIM_KAT_ENABLED=1
# Innere Trials je Prüflauf. Höher = strenger, aber vier Läufe pro Skript.
SIM_KAT_TRIALS=400

# === Volltext und Belegstellen ===
# Obergrenze für den gespeicherten Dokumenttext einer Quelle. 300k Zeichen sind
# ein langes Paper; der Deckel verhindert, dass ein Buch-PDF die Platte füllt.
FULLTEXT_MAX_CHARS=300000
# Seiten, die aus einem PDF gelesen werden.
FULLTEXT_MAX_PAGES=40
# Wie viele ältere Quellen pro Zyklus von Abstract auf Volltext aufgerüstet
# werden. 0 schaltet das Aufrüsten ab (neue Quellen werden weiterhin geholt).
FULLTEXT_PER_CYCLE=3
# Wie viele Quellen pro Zyklus nachgelesen werden, die Text haben, aber noch
# keine einzige Faktzeile (der Korpus wächst schneller als das Lesebudget:
# 495 solche Quellen am 28.10.). 0 schaltet das Nachlesen ab.
ANALYSIS_BACKFILL_PER_CYCLE=3
# Catch-up-Modus: solange mehr als BACKLOG_CATCHUP_AT Quellen Text haben, aber
# keine Faktzeile, sucht der Zyklus weniger und liest mehr. Der Rückstand wuchs
# am 28.10. um ~20 Quellen pro Zyklus, während 3 gelesen wurden.
BACKLOG_CATCHUP_AT=150
BACKLOG_CATCHUP_QUERIES=1
BACKLOG_CATCHUP_BACKFILL=8
# Wie viele Hypothesen-Quelle-Paare pro Zyklus klassifiziert werden dürfen. Der
# Wert ist eine Obergrenze: liefern die letzten drei Zyklen keine einzige
# gerichtete Zeile, sinkt das Budget auf ein Drittel (mind. 4).
EVIDENCE_EVAL_PER_CYCLE=20

# === Forschungsprogramm ===
# Das Thema wird beim Start in Teilfragen zerlegt; der Zyklus arbeitet die mit
# dem höchsten Grenznutzen, bis ihre Abschlussregel greift. 0 = kein Programm,
# der Lauf fällt auf die alte Fragenschleife zurück.
PROGRAM_ENABLED=1
# Anzahl der Teilfragen (4-6 sind praktikabel; 30 Teilfragen sind die
# Fragenschleife mit Zwischenschritten).
PROGRAM_ITEMS=6
# Zyklenbudget je Teilfrage. 0 = kein Budget (nur Sättigung beendet sie).
PROGRAM_ITEM_BUDGET_CYCLES=8
# Zyklen in Folge ohne neue Quelle, keinen neuen Fakt und keine neue Evidenzzeile,
# nach denen eine Teilfrage geschlossen wird. 0 = aus.
PROGRAM_SATURATION_CYCLES=3
# Frühestens nach so vielen Zyklen darf eine Teilfrage geschlossen werden.
PROGRAM_MIN_CYCLES=2

# === Metaanalyse aus Literatur ===
# Wie viele Dokumente pro Zyklus auf Effektstärken gelesen werden. Jedes kostet
# zwei LLM-Pässe (die Zahl wird zweimal gelesen; nur ein übereinstimmendes Paar
# ist poolbar). Werte < 1 werden als 1 behandelt.
META_EFFECTS_PER_CYCLE=1
# Ab wie vielen Studien gepoolt wird. Darunter sagt der Bericht "zu wenige"
# statt einen Mittelwert über zwei heterogene Zahlen zu drucken.
META_MIN_STUDIES=2
# Ziel-Outcomes aus der Forschungsfrage ableiten (ein LLM-Aufruf pro Thema, danach
# eingefroren). Ohne sie bildet die Formulierung des Modells die Gruppen, und
# "IQ" und "fluid intelligence" landen als zwei Studien mit k = 1 nebeneinander.
META_TARGETS_ENABLED=1

# === LLM Watchdog ===
# After this many consecutive failed LLM calls the run pauses and waits for the
# backend instead of burning whole cycles that produce nothing. 0 disables it.
LLM_FAILURE_THRESHOLD=5
# Seconds between backend health checks while paused.
LLM_RECOVERY_INTERVAL=60
