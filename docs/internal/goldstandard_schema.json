{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-research.local/goldstandard.schema.json",
  "title": "Goldstandard fuer Effektzeilen",
  "description": "Eine Datei pro Annotator und Runde. Der Konsens ist eine dritte Datei mit annotator=consensus. Die Anleitung steht in docs/internal/goldstandard_annotationsanleitung.md.",
  "type": "object",
  "required": ["dataset", "version", "annotator", "annotation_date", "instructions_version", "blind", "documents"],
  "additionalProperties": false,
  "properties": {
    "dataset": {"const": "goldstandard_effects"},
    "version": {"const": "1.0"},
    "annotator": {"enum": ["A", "B", "consensus"]},
    "annotation_date": {"type": "string", "format": "date"},
    "instructions_version": {"type": "string", "minLength": 3},
    "blind": {"type": "boolean", "description": "true = keine Modell- oder DB-Ergebnisse gesehen"},
    "notes": {"type": "string"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["document_id", "path", "title", "design_verbatim", "design_category",
                   "stratum", "has_text_layer", "effects", "no_effect_reason"],
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9]{8,40}$",
          "description": "Dateistamm des Volltexts ohne .txt"
        },
        "path": {
          "type": "string",
          "pattern": "^fulltext/[a-z0-9]{8,40}\\.txt$"
        },
        "title": {"type": "string", "minLength": 5},
        "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
        "design_verbatim": {"type": "string", "minLength": 3},
        "design_category": {
          "enum": ["parallel_rct", "crossover_rct", "cluster_rct", "quasi_experimental",
                   "observational", "aggregate", "unknown"]
        },
        "stratum": {
          "enum": ["rct", "crossover", "cohort", "cross_sectional", "case_control",
                   "aggregate", "negative_control"]
        },
        "has_text_layer": {"type": "boolean"},
        "probelauf": {"type": "boolean"},
        "expected_effects": {"type": ["integer", "null"], "minimum": 0},
        "effects": {
          "type": "array",
          "items": {"$ref": "#/$defs/effect"}
        },
        "no_effect_reason": {
          "type": ["string", "null"],
          "description": "Pflicht mit Begruendung, wenn effects leer ist; sonst null."
        },
        "notes": {"type": "string"}
      }
    },
    "effect": {
      "type": "object",
      "required": ["effect_id", "outcome_verbatim", "outcome_normalized", "comparison_verbatim",
                   "effect_type", "effect", "ci_low", "ci_high", "quote", "quote_start",
                   "quote_end", "design_verbatim", "certainty", "is_primary"],
      "additionalProperties": false,
      "properties": {
        "effect_id": {"type": "string", "pattern": "^[a-z0-9]{8,40}-[0-9]{2,3}$"},
        "outcome_verbatim": {"type": "string", "minLength": 2},
        "outcome_normalized": {"type": "string", "minLength": 2},
        "comparison_verbatim": {"type": "string", "minLength": 2},
        "effect_type": {
          "enum": ["or", "rr", "hr", "md", "smd", "g", "beta", "r", "z", "other"]
        },
        "effect": {"type": "number"},
        "se": {"type": ["number", "null"], "minimum": 0},
        "ci_low": {"type": ["number", "null"]},
        "ci_high": {"type": ["number", "null"]},
        "ci_level": {"type": ["number", "null"], "exclusiveMinimum": 0.5, "exclusiveMaximum": 0.999},
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "n": {"type": ["integer", "null"], "minimum": 1},
        "adjusted": {"type": ["boolean", "null"]},
        "time_point": {"type": ["string", "null"]},
        "time_point_segments": {
          "type": ["object", "null"],
          "description": "Abgeleitete Segmentierung von time_point. time_point bleibt die annotierte Quelle; die Segmentierung ersetzt ihn nicht und aendert keine Outcome-Werte. Nur post_treatment_weeks darf als Post-Treatment-Treffer gelten. Erzeugt mit public_benchmark/scripts/segment_timepoint_schema.py.",
          "additionalProperties": false,
          "required": ["status", "post_treatment_weeks", "follow_up_weeks",
                       "other_weeks", "ambiguous_post_treatment"],
          "properties": {
            "status": {
              "enum": ["parsed", "no_marker", "unparsed", "missing"],
              "description": "no_marker = Zeitangabe ohne Post-/Follow-up-Marker; zaehlt nicht als Post-Treatment. Median- und ±-Angaben werden konservativ nicht als Wochenwert uebernommen."
            },
            "post_treatment_weeks": {
              "type": "array",
              "items": {"type": "number", "minimum": 0}
            },
            "follow_up_weeks": {
              "type": "array",
              "items": {"type": "number", "minimum": 0}
            },
            "other_weeks": {
              "type": "array",
              "items": {"type": "number", "minimum": 0},
              "description": "Mid-Treatment, Baseline oder Zeitangaben ohne Marker."
            },
            "ambiguous_post_treatment": {"type": "boolean"},
            "raw": {"type": ["string", "null"]}
          }
        },
        "population": {"type": ["string", "null"]},
        "design_verbatim": {"type": "string", "minLength": 3},
        "quote": {
          "type": "string",
          "minLength": 8,
          "description": "Wortwoertlicher Text aus dem Volltext, exakt quote_start..quote_end"
        },
        "quote_start": {"type": "integer", "minimum": 0},
        "quote_end": {"type": "integer", "minimum": 1},
        "section": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"]},
        "source_table": {"type": ["string", "null"]},
        "certainty": {"enum": ["high", "medium", "low"]},
        "is_primary": {
          "type": "boolean",
          "description": "false fuer den gepoolten Schaetzer einer Uebersichtsarbeit"
        },
        "notes": {"type": "string"}
      }
    }
  }
}
